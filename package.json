{
  "name": "codeweave",
  "version": "0.0.0",
  "private": true,
  "description": "Codeweave desktop app",
  "author": "Codeweave",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:rotation": "CODEWEAVE_ROTATION_E2E=1 vitest run --project rotation && playwright test --config playwright.rotation.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@xyflow/react": "12.12.0",
    "diff": "9.0.0",
    "elkjs": "0.12.0",
    "node-pty": "1.1.0",
    "shell-quote": "1.12.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shell-quote": "1.7.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
